# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/roaya_leads?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CSRF Protection (optional - will use JWT_SECRET as fallback)
CSRF_SECRET=your-csrf-secret-min-32-characters-long-here

# SMTP - WorldPosta (credentials stay in server .env or local .env.local)
SMTP_HOST=smtpapp.worldposta.com
SMTP_PORT=465
SMTP_USER=info@roaya.co
SMTP_PASS=ktmbttIQ
MAIL_FROM=info@roaya.co
FORMS_RECEIVER=r.eid@roaya.co

# SendGrid (fallback only when SMTP_HOST is not set)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@roaya.ai
SENDGRID_FROM_NAME=Roaya AI

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL=admin@roaya.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FORM_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=5

# CORS
# Comma-separated. First origin is used for links in emails.
# Angular admin runs on :4200. For production, set your domain: https://roaya.co
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Data Retention (Analytics Cleanup Cron)
# Number of days to retain analytics data before automatic deletion
RECORDING_RETENTION_DAYS=30    # Session recordings (largest storage footprint)
DATA_RETENTION_DAYS=90         # Page views and heatmap clicks
SESSION_RETENTION_DAYS=180     # Analytics sessions (parent table, kept longest)
