# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/roaya_leads?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CSRF Protection (optional - will use JWT_SECRET as fallback)
CSRF_SECRET=your-csrf-secret-min-32-characters-long-here

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@roaya.ai
SENDGRID_FROM_NAME=Roaya AI

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL=admin@roaya.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FORM_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=5

# CORS
# For production, set to your actual domain: https://roaya.co
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Roaya website RAG assistant (keep API keys server-side only)
RAG_GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_VECTOR_STORE_ID=
RAG_CORPUS_PATH=../roaya-website/rag/corpus.json
RAG_ENABLE_CMS=true
RAG_ENABLE_VECTOR_SEARCH=false
RAG_MAX_RESULTS=4
RAG_MAX_CONTEXT_CHARS=4200
RAG_MAX_OUTPUT_TOKENS=320
RAG_CACHE_TTL_MS=600000
RAG_CACHE_MAX_ENTRIES=200
RAG_VECTOR_SCORE_THRESHOLD=0.58
RAG_LOCAL_SCORE_THRESHOLD=0.34

# Data Retention (Analytics Cleanup Cron)
# Number of days to retain analytics data before automatic deletion
RECORDING_RETENTION_DAYS=30    # Session recordings (largest storage footprint)
DATA_RETENTION_DAYS=90         # Page views and heatmap clicks
SESSION_RETENTION_DAYS=180     # Analytics sessions (parent table, kept longest)
