{
  "name": "roaya-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:ssr:roaya-website": "node dist/roaya-website/server/server.mjs",
    "validate:llms-txt": "node scripts/validate-llms-txt.mjs",
    "test:llms-txt:selftest": "node scripts/validate-llms-txt.selftest.mjs",
    "validate:claims": "node scripts/claim-evidence/validate-registry.mjs",
    "test:claims:selftest": "node scripts/claim-evidence/validate-registry.selftest.mjs",
    "ai-readiness": "node scripts/ai-readiness/check.mjs",
    "test:ai-readiness:selftest": "node scripts/ai-readiness/checks.selftest.mjs",
    "test:deploy-runtime-config": "node scripts/deploy/validate-runtime-config.mjs",
    "test:deploy-runtime-config:selftest": "node scripts/deploy/validate-runtime-config.selftest.mjs",
    "test:deploy-health-gate": "bash scripts/deploy/health-gate.simulation.sh",
    "test:proxy-headers": "bash scripts/deploy/proxy-header-matrix.test.sh",
    "test:build-toolchain": "node scripts/deploy/validate-build-toolchain.mjs",
    "test:build-toolchain:selftest": "node scripts/deploy/validate-build-toolchain.selftest.mjs",
    "test:build-exit": "bash scripts/deploy/build-exit-regression.sh",
    "verify:evidence": "npm run validate:claims && npm run test:claims:selftest && npm run test:llms-txt:selftest && npm run test:ai-readiness:selftest && npm run ai-readiness"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/animations": "^21.2.21",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/forms": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/platform-server": "^21.2.21",
    "@angular/router": "^21.2.21",
    "@angular/ssr": "^21.2.21",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/font-awesome": "^33.0.0",
    "@ng-icons/lucide": "^33.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^16.0.1",
    "@tsparticles/angular": "^3.0.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/slim": "^3.9.1",
    "animejs": "3.2.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "heatmap.js": "^2.0.5",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.4",
    "quill": "^2.0.3",
    "rrweb": "^2.0.0-alpha.4",
    "rrweb-player": "^1.0.0-alpha.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "^21.2.21",
    "@sentry/angular": "^10.38.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/animejs": "3.1.13",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.22",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
