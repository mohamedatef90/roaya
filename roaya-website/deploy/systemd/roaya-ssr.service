[Unit]
Description=Roaya website — Angular SSR Node server
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__WEBSITE_DEPLOY_PATH__
# Built by: npm ci && npm run build:prod (see docs/deploy/RUNTIME-ENV.md)
ExecStart=/usr/bin/node __WEBSITE_DEPLOY_PATH__/dist/roaya-website/server/server.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=__SSR_PORT__
# REQUIRED. @angular/ssr >= 21 rejects any request whose Host header hostname
# is not listed here and silently serves browser/index.csr.html with HTTP 200
# instead of the rendered page. Hostnames only — the check ignores the port.
# nginx forwards `proxy_set_header Host $host`, so real traffic only ever
# presents these two. Do NOT add localhost, 127.0.0.1, or '*'; loopback health
# checks must send `Host: roaya.co`. See docs/deploy/RUNTIME-ENV.md.
Environment=NG_ALLOWED_HOSTS=roaya.co,www.roaya.co
# REQUIRED. nginx forwards X-Forwarded-For and X-Forwarded-Proto; @angular/ssr
# silently serves the CSR shell with HTTP 200 when an X-Forwarded-* header is
# untrusted. The explicit list REPLACES Angular's defaults, so it names exactly
# what nginx sends. Never 'true'/wildcard. x-real-ip is not an X-Forwarded-*
# header and is not governed by this option. See docs/deploy/RUNTIME-ENV.md.
Environment=NG_TRUST_PROXY_HEADERS=x-forwarded-for,x-forwarded-proto
# Backend API origin for server-side rendering. The production apiUrl is
# origin-relative ('/api/v1'); with this set, the SSR API interceptor forwards
# GET content requests to the loopback backend so blog pages carry real
# content in the raw first response. Unset = API-backed pages server-render
# their empty/default state. See docs/deploy/RUNTIME-ENV.md.
Environment=NG_SSR_API_ORIGIN=http://127.0.0.1:3001
# Add any runtime env vars the app reads (API base URL, analytics keys, etc.)
# via EnvironmentFile instead of hardcoding secrets in this unit file:
EnvironmentFile=-__WEBSITE_DEPLOY_PATH__/.env.production

StandardOutput=append:/var/log/roaya/ssr-out.log
StandardError=append:/var/log/roaya/ssr-error.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
